# ---- 构建产物 ----
build/
dist/
__pycache__/

# ---- 项目私有记忆（不入库） ----
.workbuddy/

# ---- 测试样本（含真实发票图片，不入库） ----
test_samples/

# ---- 虚拟环境（不入库） ----
envs/

# ---- 打包产物与发布素材（通过 GitHub Releases 分发，不提交进仓库） ----
outputs/

# ---- 下载的源码基线压缩包（本地保留即可，不入库） ----
*.tar.gz

# ---- 敏感/自动生成（不入库） ----
.github_token
.last_release_commit
# 签名证书、私钥与口令（放用户级 ~/.workbuddy/signing/，任何情况下都不入库）
signing/
*.pfx
*.p12
pfx_pass.txt
# 一次性开发脚本 / 本地补丁（含本机绝对路径，不入库）
make_update.py
*.local.py
# CLI 自检（--test）在程序目录写的运行日志，属临时产物
test_run.log
# GUI 版实时落盘的运行日志（排查卡死用），属临时产物
运行日志.txt
